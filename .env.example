# Copia este archivo como .env y completa los valores.
PORT=3000
JWT_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria

DB_HOST=tu-servicio.aivencloud.com
DB_PORT=19911
DB_USER=avnadmin
DB_PASSWORD=tu-contraseña
DB_NAME=betel

# Aiven exige SSL. El certificado CA puede ir como archivo (DB_SSL_CA_PATH)
# o pegado en DB_SSL_CA (útil en hostings como Render/Railway).
DB_SSL=true
DB_SSL_CA_PATH=certs/aiven-ca.pem
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
